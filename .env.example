# Infinisper Environment Configuration Example
# Copy this file to .env and insert your API keys if you want to use cloud multimodal models.

# Optional: Google Gemini API key for cloud multimodal text/audio refinement
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom Ollama endpoint (defaults to http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434
